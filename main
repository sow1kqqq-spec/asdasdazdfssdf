def _get_base_ytdlp_opts():
    opts = {
        'quiet': True,
        'no_warnings': True,
        'socket_timeout': 15,
        'extractor_args': {'youtube': {'player_client': ['android', 'ios', 'web']}},
    }
    if _is_valid_netscape_cookies(COOKIES_FILE):
        opts['cookiefile'] = COOKIES_FILE
    return opts


def _ensure_cyrillic_fonts():
    reg_path = os.path.join(FONTS_DIR, "Roboto-Regular.ttf")
    bold_path = os.path.join(FONTS_DIR, "Roboto-Bold.ttf")
    urls = [
        (reg_path, "https://github.com/googlefonts/roboto/raw/main/src/hinted/Roboto-Regular.ttf"),
        (bold_path, "https://github.com/googlefonts/roboto/raw/main/src/hinted/Roboto-Bold.ttf"),
    ]
    for path, url in urls:
        if not os.path.exists(path) or os.path.getsize(path) < 10000:
            try:
                r = http_session.get(url, timeout=10)
                if r.status_code == 200 and len(r.content) > 10000:
                    with open(path, "wb") as f:
                        f.write(r.content)
            except Exception:
                pass


threading.Thread(target=_ensure_cyrillic_fonts, daemon=True).start()


def load_users():
    for path in (USERS_FILE, "users_db.json"):
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    if isinstance(data, list):
                        return set(int(u) for u in data if int(u) > 0)
            except Exception:
                pass
    return set()


def save_user(user_id):
    if not user_id or int(user_id) <= 0:
        return
    try:
        if bot.get_me().id == int(user_id):
            return
    except Exception:
        pass
    users = load_users()
    if int(user_id) not in users:
        users.add(int(user_id))
        try:
            with open(USERS_FILE, "w", encoding="utf-8") as f:
                json.dump(list(users), f)
        except Exception:
            pass


def safe_reply(message, text, **kwargs):
    if "parse_mode" not in kwargs and "<tg-emoji" in str(text):
        kwargs["parse_mode"] = "HTML"
    try:
        return bot.reply_to(message, text, **kwargs)
    except Exception:
        return None


def safe_edit(text, chat_id, message_id, **kwargs):
    if not message_id:
        return
    if "parse_mode" not in kwargs and ("<tg-emoji" in str(text) or "<b>" in str(text) or "<i>" in str(text)):
        kwargs["parse_mode"] = "HTML"
    try:
        bot.edit_message_text(text, chat_id, message_id, **kwargs)
    except Exception:
        pass


PROMPT_TTL = 15


def schedule_delete(chat_id, message_id, delay=PROMPT_TTL):
    def _del():
        try:
            bot.delete_message(chat_id, message_id)
        except Exception:
            pass
    t = threading.Timer(delay, _del)
    t.daemon = True
    t.start()
    return t


def get_storage_chat_id():
    if os.path.exists(STORAGE_FILE):
        try:
            with open(STORAGE_FILE, "r") as f:
                return int(f.read().strip())
        except Exception:
            pass
    return None


def save_storage_chat_id(chat_id):
    try:
        with open(STORAGE_FILE, "w") as f:
            f.write(str(chat_id))
    except Exception:
        pass


def check_user_subscription(user_id):
    if not user_id:
        return False
    if int(user_id) == ADMIN_USER_ID:
        return True

    for channel_target in (NEWS_CHANNEL_USERNAME, NEWS_CHANNEL_ID):
        try:
            member = bot.get_chat_member(channel_target, user_id)
            if member.status in ('member', 'administrator', 'creator'):
                return True
            if member.status == 'restricted' and getattr(member, 'is_member', False):
                return True
            if member.status in ('left', 'kicked'):
                return False
        except Exception as e:
            print(f"[Sub Check Warning] {channel_target}: {e}")
            continue

    return False


def send_subscription_required(chat_id, reply_to_message_id=None):
    markup = types.InlineKeyboardMarkup(row_width=1)
    btn_sub = types.InlineKeyboardButton(
        text="✅ Подписаться",
