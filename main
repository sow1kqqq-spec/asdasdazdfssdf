@bot.middleware_handler(update_types=['message'])
def cache_messages(bot_instance, message):
    chat_history_cache[message.chat.id].append(message)
    if len(chat_history_cache[message.chat.id]) > 100:
        chat_history_cache[message.chat.id].pop(0)

