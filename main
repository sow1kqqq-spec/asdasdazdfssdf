def _is_valid_netscape_cookies(path):
    if not os.path.exists(path) or os.path.getsize(path) < 50:
        return False
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read(1000)
            if "Netscape" in content or "\t" in content:
                return True
    except Exception:
        pass
    return False

if os.path.exists(COOKIES_FILE) and not _is_valid_netscape_cookies(COOKIES_FILE):
    try:
        os.remove(COOKIES_FILE)
    except Exception:
        pass

