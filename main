        bot.send_message(
            chat_id,
            text,
            parse_mode="HTML",
            reply_markup=markup,
            reply_to_message_id=reply_to_message_id,
            allow_sending_without_reply=True,
            disable_web_page_preview=True
        )
    except Exception:
        pass


@bot.callback_query_handler(func=lambda call: call.data == "sub_check")
def handle_sub_check_callback(call):
    user_id = call.from_user.id
    chat_id = call.message.chat.id
    save_user(user_id)

    if check_user_subscription(user_id):
        bot.answer_callback_query(call.id)
        try:
            bot.delete_message(chat_id, call.message.message_id)
        except Exception:
            pass

        try:
            temp_msg = bot.send_message(chat_id, f"{E_CHECK}", parse_mode="HTML")
            time.sleep(0.9)
            bot.delete_message(chat_id, temp_msg.message_id)
        except Exception:
            pass

        if call.message.chat.type == 'private':
            try:
                bot.send_message(
                    chat_id,
                    WELCOME_TEXT_HTML,
                    parse_mode="HTML"
                )
            except Exception:
                pass
    else:
        bot.answer_callback_query(call.id, "❌ Вы еще не подписались на канал!", show_alert=True)


admin_broadcast_states = {}


def _admin_panel_markup():
    markup = types.InlineKeyboardMarkup(row_width=1)
    markup.add(
        types.InlineKeyboardButton("🔄 Обновить", callback_data="admin_refresh"),
        types.InlineKeyboardButton("📢 Сделать рассылку", callback_data="admin_start_broadcast"),
        types.InlineKeyboardButton("❌ Закрыть", callback_data="admin_close")
    )
    return markup


def _admin_panel_text():
    return (
        f"{E_OWNER} <b>Панель администратора:</b>\n\n"
        f"👥 Пользователей в боте: <b>{len(load_users())}</b>\n"
        f"🕒 Обновлено: {time.strftime('%H:%M:%S')}"
    )


@bot.message_handler(commands=['admin'])
def admin_panel_command(message):
    save_user(message.from_user.id)
    if message.from_user.id != ADMIN_USER_ID:
        return
    bot.send_message(
        message.chat.id,
        _admin_panel_text(),
        parse_mode="HTML",
        reply_markup=_admin_panel_markup()
    )


@bot.callback_query_handler(func=lambda call: call.data.startswith("admin_"))
def handle_admin_callbacks(call):
    if call.from_user.id != ADMIN_USER_ID:
        bot.answer_callback_query(call.id, "❌ Доступ запрещен", show_alert=True)
        return

    action = call.data

    if action == "admin_refresh":
        bot.answer_callback_query(call.id, "Обновлено")
        try:
            bot.edit_message_text(
                _admin_panel_text(),
                call.message.chat.id,
                call.message.message_id,
                parse_mode="HTML",
                reply_markup=_admin_panel_markup()
            )
        except Exception:
            pass

    elif action == "admin_start_broadcast":
        admin_broadcast_states[call.from_user.id] = True
        bot.answer_callback_query(call.id)
        bot.send_message(
            call.message.chat.id,
            f"📢 <b>Режим рассылки:</b>\n\nОтправьте сообщение (текст, фото, видео, кружочек или аудио), которое хотите разослать всем пользователям.\nВ начале автоматически добавится: <b>от владельца</b> {E_OWNER}\n\nДля отмены напишите <code>/cancel</code>",
            parse_mode="HTML"
        )
        try:
            bot.delete_message(call.message.chat.id, call.message.message_id)
        except Exception:
            pass

    elif action == "admin_close":
        admin_broadcast_states.pop(call.from_user.id, None)
        try:
            bot.delete_message(call.message.chat.id, call.message.message_id)
        except Exception:
            pass


@bot.message_handler(
    func=lambda m: m.from_user is not None and m.from_user.id == ADMIN_USER_ID and admin_broadcast_states.get(m.from_user.id) is True,
    content_types=['text', 'photo', 'video', 'document', 'audio', 'animation', 'voice', 'video_note']
)
def process_broadcast_message(message):
    if message.text and message.text.strip().lower() in ('/cancel', 'отмена'):
        admin_broadcast_states.pop(message.from_user.id, None)
        bot.reply_to(message, f"{E_CROSS} Рассылка отменена.", parse_mode="HTML")
        return

    admin_broadcast_states.pop(message.from_user.id, None)

    users = list(load_users())
    status_msg = bot.reply_to(message, f"🚀 Начинаю рассылку ({len(users)} чел.)...")

    prefix_html = f"<b>от владельца</b> {E_OWNER}\n\n"

    def run_broadcast():
        success = 0
        unreachable = 0
        active_users = set(users)

        for uid in users:
            try:
                if message.content_type == 'text':
                    orig_html = getattr(message, 'html_text', None) or message.text or ""
                    bot.send_message(uid, prefix_html + orig_html, parse_mode="HTML")
                elif message.photo:
                    orig_cap = getattr(message, 'html_caption', None) or message.caption or ""
                    bot.send_photo(uid, message.photo[-1].file_id, caption=prefix_html + orig_cap, parse_mode="HTML")
                elif message.video:
                    orig_cap = getattr(message, 'html_caption', None) or message.caption or ""
                    bot.send_video(uid, message.video.file_id, caption=prefix_html + orig_cap, parse_mode="HTML")
                elif message.animation:
                    orig_cap = getattr(message, 'html_caption', None) or message.caption or ""
                    bot.send_animation(uid, message.animation.file_id, caption=prefix_html + orig_cap, parse_mode="HTML")
                elif message.document:
                    orig_cap = getattr(message, 'html_caption', None) or message.caption or ""
                    bot.send_document(uid, message.document.file_id, caption=prefix_html + orig_cap, parse_mode="HTML")
                elif message.audio:
                    orig_cap = getattr(message, 'html_caption', None) or message.caption or ""
                    bot.send_audio(uid, message.audio.file_id, caption=prefix_html + orig_cap, parse_mode="HTML")
                elif message.voice:
                    orig_cap = getattr(message, 'html_caption', None) or message.caption or ""
                    bot.send_voice(uid, message.voice.file_id, caption=prefix_html + orig_cap, parse_mode="HTML")
                else:
                    bot.send_message(uid, f"<b>от владельца</b> {E_OWNER}", parse_mode="HTML")
                    bot.copy_message(chat_id=uid, from_chat_id=message.chat.id, message_id=message.message_id)
                success += 1
            except Exception as e:
                err_str = str(e).lower()
                unreachable += 1
                if "chat not found" in err_str or "user is deactivated" in err_str or "bot was blocked" in err_str:
                    active_users.discard(uid)
            time.sleep(0.05)

        try:
            with open(USERS_FILE, "w", encoding="utf-8") as f:
                json.dump(list(active_users), f)
        except Exception:
            pass

        try:
            bot.edit_message_text(
                f"{E_CHECK} <b>Рассылка завершена!</b>\n\n"
                f"• Успешно доставлено в ЛС: <b>{success}</b>\n"
                f"• Не открыли ЛС с ботом / Заблокировали: <b>{unreachable}</b>",
                chat_id=message.chat.id,
                message_id=status_msg.message_id,
                parse_mode="HTML"
            )
        except Exception:
            pass

    threading.Thread(target=run_broadcast, daemon=True).start()


NAME_COLORS = [
    (210, 45, 45),
    (0, 115, 230),
    (40, 160, 60),
    (220, 130, 0),
    (140, 60, 210),
    (210, 40, 140),
]


def _has_cjk(text):
    return bool(re.search(r'[\u3000-\u9fff\uf900-\ufaff\uff00-\uffef]', text or ''))


def _load_font(size, bold=False, text_sample=""):
    _ensure_cyrillic_fonts()
    candidates = [
        os.path.join(FONTS_DIR, "Roboto-Bold.ttf" if bold else "Roboto-Regular.ttf"),
    ]
    if os.name == "nt":
        win_fonts = os.path.join(os.environ.get("WINDIR", "C:\\Windows"), "Fonts")
        if _has_cjk(text_sample):
            candidates += [
                os.path.join(win_fonts, "msyhbd.ttc" if bold else "msyh.ttc"),
                os.path.join(win_fonts, "YuGothB.ttc" if bold else "YuGothM.ttc"),
                os.path.join(win_fonts, "msgothic.ttc"),
                os.path.join(win_fonts, "malgunbd.ttf" if bold else "malgun.ttf"),
            ]
        if bold:
            candidates += [
                os.path.join(win_fonts, "segoeuib.ttf"),
                os.path.join(win_fonts, "arialbd.ttf"),
                os.path.join(win_fonts, "msyhbd.ttc"),
            ]
        else:
            candidates += [
                os.path.join(win_fonts, "segoeui.ttf"),
                os.path.join(win_fonts, "arial.ttf"),
                os.path.join(win_fonts, "msyh.ttc"),
            ]
    else:
        if _has_cjk(text_sample):
            candidates += [
                "/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc" if bold else "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
                "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
            ]
        if bold:
            candidates += [
                "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
                "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
            ]
        else:
            candidates += [
                "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
                "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
            ]

    for path in candidates:
        if os.path.exists(path):
            try:
                return ImageFont.truetype(path, size)
            except Exception:
                pass
    return ImageFont.load_default()


def _get_user_avatar_image(user_id, first_name, color_rgb, size=78):
    avatar_img = None
    try:
        photos = bot.get_user_profile_photos(user_id, limit=1)
        if photos and photos.total_count > 0 and photos.photos:
            file_id = photos.photos[0][-1].file_id
            file_info = bot.get_file(file_id)
            raw_bytes = bot.download_file(file_info.file_path)
            avatar_img = Image.open(io.BytesIO(raw_bytes)).convert("RGBA")
            avatar_img = avatar_img.resize((size, size), Image.Resampling.LANCZOS)
    except Exception:
        avatar_img = None

    if avatar_img is None:
        avatar_img = Image.new("RGBA", (size, size), (*color_rgb, 255))
        draw = ImageDraw.Draw(avatar_img)
        letter = (first_name or "?")[0].upper()
        font_init = _load_font(int(size * 0.46), bold=True, text_sample=letter)
        bbox = draw.textbbox((0, 0), letter, font=font_init)
        tw, th = bbox[2] - bbox[0], bbox[3] - bbox[1]
        draw.text(
            ((size - tw) / 2 - bbox[0], (size - th) / 2 - bbox[1]),
            letter,
            font=font_init,
            fill=(255, 255, 255, 255)
        )

    mask = Image.new("L", (size, size), 0)
    mask_draw = ImageDraw.Draw(mask)
    mask_draw.ellipse((0, 0, size - 1, size - 1), fill=255)

    circle_avatar = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    circle_avatar.paste(avatar_img, (0, 0), mask)
    return circle_avatar


def _wrap_text_by_pixel_width(draw, text, font, max_width):
    lines = []
    for paragraph in text.split("\n"):
        if not paragraph.strip():
            lines.append("")
            continue
        words = paragraph.split(" ")
        current_line = ""
        for word in words:
            test_line = f"{current_line} {word}".strip() if current_line else word
            bbox = draw.textbbox((0, 0), test_line, font=font)
            if (bbox[2] - bbox[0]) <= max_width:
                current_line = test_line
            else:
                if current_line:
                    lines.append(current_line)
                w_bbox = draw.textbbox((0, 0), word, font=font)
                if (w_bbox[2] - w_bbox[0]) > max_width:
                    chunk = ""
                    for ch in word:
                        t_chunk = chunk + ch
                        if (draw.textbbox((0, 0), t_chunk, font=font)[2]) <= max_width:
                            chunk = t_chunk
                        else:
                            lines.append(chunk)
                            chunk = ch
                    current_line = chunk
                else:
                    current_line = word
        if current_line:
            lines.append(current_line)
    return lines or [""]


def get_user_chat_prefix(chat_id, user_id, target_msg=None):
    if target_msg and getattr(target_msg, 'author_signature', None):
        return target_msg.author_signature.strip()
    try:
        member = bot.get_chat_member(chat_id, user_id)
        if getattr(member, 'custom_title', None):
            return member.custom_title.strip()
        if member.status == 'creator':
            return "Владелец"
        if member.status == 'administrator':
            return "Админ"
    except Exception:
        pass
    return ""


QUOTE_BUBBLE_FILL = (28, 30, 36, 235)
QUOTE_BUBBLE_OUTLINE = (255, 255, 255, 30)
QUOTE_TEXT_COLOR = (235, 237, 242, 255)
QUOTE_PREFIX_COLOR = (130, 180, 255, 255)
NAME_COLORS_DARK = [
    (255, 95, 95),
    (90, 165, 255),
    (90, 210, 120),
    (255, 170, 60),
    (190, 130, 255),
    (255, 110, 190),
]


def create_quote_sticker_webp(user_id, display_name, quote_text, user_prefix=""):
    font_name = _load_font(22, bold=True, text_sample=display_name)
    font_prefix = _load_font(15, bold=False, text_sample=user_prefix or "")
    font_text = _load_font(20, bold=False, text_sample=quote_text)

    dummy_img = Image.new("RGBA", (10, 10))
    dummy_draw = ImageDraw.Draw(dummy_img)

    max_text_width = 280
    wrapped_lines = _wrap_text_by_pixel_width(dummy_draw, quote_text, font_text, max_text_width)

    name_bbox = dummy_draw.textbbox((0, 0), display_name, font=font_name)
    name_w = name_bbox[2] - name_bbox[0]
    name_h = name_bbox[3] - name_bbox[1]

    prefix_w = 0
    prefix_h = 0
    if user_prefix:
        p_bbox = dummy_draw.textbbox((0, 0), user_prefix, font=font_prefix)
        prefix_w = p_bbox[2] - p_bbox[0]
        prefix_h = p_bbox[3] - p_bbox[1]

    line_heights = []
    max_line_w = 0
    for ln in wrapped_lines:
        if ln:
            bb = dummy_draw.textbbox((0, 0), ln, font=font_text)
            lw = bb[2] - bb[0]
            lh = bb[3] - bb[1]
        else:
            lw, lh = 0, 16
        max_line_w = max(max_line_w, lw)
        line_heights.append(max(lh, 24))

    pad_x = 18
    pad_y = 12
    line_spacing = 4

    top_row_w = name_w + (prefix_w + 14 if user_prefix else 0)
    content_w = max(top_row_w, max_line_w)
    bubble_w = max(120, content_w + pad_x * 2)
    total_text_h = sum(line_heights) + line_spacing * max(0, len(wrapped_lines) - 1)
    bubble_h = max(64, pad_y * 2 + name_h + 6 + total_text_h)

    avatar_size = 64
    gap = 12
    margin = 24

    actual_w = margin * 2 + avatar_size + gap + bubble_w
    actual_h = margin * 2 + max(avatar_size, bubble_h)

    canvas = Image.new("RGBA", (actual_w, actual_h), (0, 0, 0, 0))
    draw = ImageDraw.Draw(canvas)

    color_idx = abs(int(user_id or 0)) % len(NAME_COLORS_DARK)
    name_color = NAME_COLORS_DARK[color_idx]

    avatar_img = _get_user_avatar_image(user_id, display_name, name_color, size=avatar_size)
    canvas.paste(avatar_img, (margin, margin), avatar_img)

    bubble_x = margin + avatar_size + gap
    bubble_y = margin
    bubble_rect = [bubble_x, bubble_y, bubble_x + bubble_w, bubble_y + bubble_h]

    bubble_fill = QUOTE_BUBBLE_FILL
    bubble_outline = QUOTE_BUBBLE_OUTLINE

    draw.rounded_rectangle(
        bubble_rect,
        radius=22,
        fill=bubble_fill,
        outline=bubble_outline,
        width=2
    )

    cur_x = bubble_x + pad_x
    cur_y = bubble_y + pad_y
    draw.text((cur_x, cur_y - name_bbox[1]), display_name, font=font_name, fill=(*name_color, 255))

    if user_prefix:
        p_bbox = draw.textbbox((0, 0), user_prefix, font=font_prefix)
        px = bubble_x + bubble_w - pad_x - prefix_w
        py = cur_y + max(0, (name_h - prefix_h) // 2) - 2
        draw.text((px, py - p_bbox[1]), user_prefix, font=font_prefix, fill=QUOTE_PREFIX_COLOR)

    cur_y += name_h + 6

    for idx, ln in enumerate(wrapped_lines):
        if ln:
            bb = draw.textbbox((0, 0), ln, font=font_text)
            draw.text((cur_x, cur_y - bb[1]), ln, font=font_text, fill=QUOTE_TEXT_COLOR)
        cur_y += line_heights[idx] + line_spacing

    max_side = max(actual_w, actual_h)
    if max_side != 384:
        scale = 384.0 / max_side
        new_w = max(1, min(384, int(round(actual_w * scale))))
        new_h = max(1, min(384, int(round(actual_h * scale))))
        canvas = canvas.resize((new_w, new_h), Image.Resampling.LANCZOS)

    out_buf = io.BytesIO()
    canvas.save(out_buf, format="WEBP", quality=95)
    out_buf.seek(0)
    return out_buf


@bot.message_handler(commands=['q', 'quote'])
def handle_quote_command(message):
    is_private = message.chat.type == 'private'
    if is_private:
        save_user(message.from_user.id)
        if not check_user_subscription(message.from_user.id):
            send_subscription_required(message.chat.id, reply_to_message_id=message.message_id)
            return

    cmd_text = message.text or ""
    m = re.match(r'^/(?:q|quote)(?:@\S+)?\s*(\d+)?', cmd_text, flags=re.IGNORECASE)
    count = int(m.group(1)) if m and m.group(1) else None

    if count and count > 10:
        count = 10

    target = message.reply_to_message
    custom_text = re.sub(r'^/(?:q|quote)(?:@\S+)?\s*(\d+)?\s*', '', cmd_text, flags=re.IGNORECASE).strip()

    if count:
        history = sorted(chat_history_cache.get(message.chat.id, []), key=lambda m: m.message_id)
        history = [msg for msg in history if msg.message_id != message.message_id]
        if target:
            history = [msg for msg in history if msg.message_id >= target.message_id]
            if not any(msg.message_id == target.message_id for msg in history):
                history.insert(0, target)
            valid_msgs = history[:count]
        else:
            valid_msgs = history[-count:]

        if not valid_msgs:
            safe_reply(message, f"{E_CROSS} Нет сообщений для цитирования", parse_mode="HTML")
            return

        quote_parts = []
        for msg in valid_msgs:
            txt = msg.text or msg.caption or ""
            if not txt:
                if msg.sticker:
                    txt = f"[Стикер {msg.sticker.emoji or ''}]"
                elif msg.photo:
                    txt = "[Фотография]"
                elif msg.video:
                    txt = "[Видео]"
                elif msg.voice:
                    txt = "[Голосовое]"
                elif msg.video_note:
                    txt = "[Кружок]"
                elif msg.audio:
                    txt = f"[Аудио: {msg.audio.title or 'Трек'}]"
                else:
                    txt = "[Медиа]"
            quote_parts.append(txt)

        quote_text = "\n\n".join(quote_parts)
        user = valid_msgs[-1].from_user or message.from_user
    else:
        if target:
            user = target.from_user
            if getattr(target, 'forward_from', None):
                user = target.forward_from
            quote_text = custom_text or target.text or target.caption or ""
            if not quote_text:
                if target.sticker:
                    quote_text = f"[Стикер {target.sticker.emoji or ''}]"
                elif target.photo:
                    quote_text = "[Фотография]"
                elif target.video:
                    quote_text = "[Видео]"
                elif target.voice:
                    quote_text = "[Голосовое сообщение]"
                elif target.video_note:
                    quote_text = "[Видеосообщение]"
                elif target.audio:
                    quote_text = f"[Аудио: {target.audio.title or 'Трек'}]"
                else:
                    quote_text = "[Медиафайл]"
        else:
            if not custom_text:
                return
            user = message.from_user
            quote_text = custom_text

    first = (user.first_name or "").strip()
    last = (user.last_name or "").strip()
    display_name = f"{first} {last}".strip() or user.username or "Пользователь"

    try:
        bot.delete_message(message.chat.id, message.message_id)
    except Exception:
        pass

    def worker():
        try:
            user_prefix = ""
            if message.chat.type != 'private':
                user_prefix = get_user_chat_prefix(message.chat.id, user.id, target_msg=target or message)
            webp_io = create_quote_sticker_webp(user.id, display_name, quote_text[:1000], user_prefix=user_prefix)
            reply_id = target.message_id if target else None
            bot.send_sticker(
                message.chat.id,
                webp_io,
                reply_to_message_id=reply_id,
                allow_sending_without_reply=True
            )
        except Exception:
            traceback.print_exc()

    threading.Thread(target=worker, daemon=True).start()


def get_video_duration(video_path):
    try:
        result = subprocess.run(
            [FFMPEG_PATH, "-i", video_path],
            capture_output=True, text=True, timeout=8
        )
        for line in result.stderr.split('\n'):
            if 'Duration' in line:
                m = re.search(r'Duration:\s*(\d+):(\d+):(\d+)(?:\.(\d+))?', line)
                if m:
                    h, mi, s = int(m.group(1)), int(m.group(2)), int(m.group(3))
                    ms = int(m.group(4)[:2]) / 100.0 if m.group(4) else 0.0
                    return h * 3600 + mi * 60 + s + ms
    except Exception:
        pass
    return 0.0


def extract_pcm_window(video_path, out_wav, ss=0.0, t=5.0, af_filter=None, loop_input=False):
    cmd = [FFMPEG_PATH, "-y"]
    if loop_input:
        cmd += ["-stream_loop", "2"]
    if ss > 0:
        cmd += ["-ss", f"{ss:.2f}"]
    cmd += ["-i", video_path, "-t", f"{t:.2f}"]
    if af_filter:
        cmd += ["-af", af_filter]
    cmd += [
        "-vn",
        "-acodec", "pcm_s16le",
        "-ar", "16000",
        "-ac", "1",
        out_wav
    ]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        if r.returncode == 0 and os.path.exists(out_wav) and os.path.getsize(out_wav) > 16000:
            return True
    except Exception as e:
        print(f"[FFmpeg Error]: {e}")
    return False


def extract_mp3_for_audd(video_path, out_mp3, ss=0.0, t=12.0):
    cmd = [
        FFMPEG_PATH, "-y",
        "-ss", f"{ss:.2f}",
        "-i", video_path,
        "-t", f"{t:.2f}",
        "-vn",
        "-acodec", "libmp3lame",
        "-b:a", "128k",
        "-ar", "44100",
        "-ac", "1",
        out_mp3
    ]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        if r.returncode == 0 and os.path.exists(out_mp3) and os.path.getsize(out_mp3) > 4000:
            return True
    except Exception:
        pass
    return False


_async_loop = asyncio.new_event_loop()
threading.Thread(target=_async_loop.run_forever, daemon=True).start()


async def _recognize_single_wav(shazam, wav_path, sem):
    async with sem:
        try:
            if hasattr(shazam, "recognize"):
                res = await shazam.recognize(wav_path)
            else:
                res = await shazam.recognize_song(wav_path)

            if isinstance(res, dict):
                track = res.get("track")
                if track and track.get("title"):
                    print(f"[Shazam HIT] {os.path.basename(wav_path)} -> {track.get('subtitle')} - {track.get('title')}")
                    return {
                        "title": track.get("title", ""),
                        "artist": track.get("subtitle", ""),
                        "artwork": (track.get("images") or {}).get("coverarthq", ""),
                        "url": track.get("url", ""),
                        "source": "shazam",
                    }
        except Exception as e:
            print(f"[Shazam Attempt Error] {os.path.basename(wav_path)}: {repr(e)}")
        return None


async def _recognize_wave_batch(wav_paths, country="US"):
    try:
        shazam = Shazam(language="en-US", endpoint_country=country)
    except TypeError:
        shazam = Shazam()

    sem = asyncio.Semaphore(3)
    tasks = [asyncio.create_task(_recognize_single_wav(shazam, p, sem)) for p in wav_paths]
    found = None
    try:
        for coro in asyncio.as_completed(tasks):
            res = await coro
            if res:
                found = res
                for t in tasks:
                    if not t.done():
                        t.cancel()
                break
    finally:
        try:
            if hasattr(shazam, "http_client"):
                client = shazam.http_client
                if hasattr(client, "close"):
                    await client.close()
                elif hasattr(client, "client") and hasattr(client.client, "close"):
                    await client.client.close()
        except Exception:
            pass
    return found


def run_shazam_batch(wav_paths, country="US"):
    if not wav_paths:
        return None
    try:
        fut = asyncio.run_coroutine_threadsafe(_recognize_wave_batch(wav_paths, country), _async_loop)
        return fut.result(timeout=45)
    except Exception as e:
        print(f"[Batch Error]: {repr(e)}")
        return None


def audd_recognize(mp3_path):
    if not AUDD_API_TOKEN or not os.path.exists(mp3_path):
        return None
    try:
        with open(mp3_path, "rb") as f:
            r = requests.post(
                "https://api.audd.io/",
                data={"api_token": AUDD_API_TOKEN, "return": "apple_music,spotify"},
                files={"file": ("sample.mp3", f, "audio/mpeg")},
                timeout=30,
            )
        data = r.json()
        status = data.get("status")
        res = data.get("result")
        print(f"[AudD] status={status} found={bool(res)}")
        if res and res.get("title"):
            return {
                "title": res.get("title", ""),
                "artist": res.get("artist", ""),
                "artwork": "",
                "url": res.get("song_link", ""),
                "source": "audd",
            }
    except Exception as e:
        print(f"[AudD Error]: {repr(e)}")
    return None


def build_sliding_offsets(duration):
    if duration <= 0 or duration <= 6.5:
        return [0.0]
    offsets = []
    mid = max(0.0, duration / 2.0 - 2.5)
    offsets.append(round(mid, 2))

    step = 2.5 if duration <= 25 else 4.0
    cur = 0.5
    while cur + 4.5 <= duration and len(offsets) < 7:
        if abs(cur - mid) >= 1.8:
            offsets.append(round(cur, 2))
        cur += step

    if duration > 7.0:
        tail = round(max(0.0, duration - 5.5), 2)
        if all(abs(tail - x) >= 1.5 for x in offsets):
            offsets.append(tail)
    return offsets[:7]


def extract_and_recognize(video_path):
    duration = get_video_duration(video_path)
    base = os.path.splitext(video_path)[0]
    is_very_short = 0 < duration < 4.8
    print(f"[Recognize] duration={duration:.2f}s file={os.path.basename(video_path)}")

    offsets = build_sliding_offsets(duration)
    mid_offset = offsets[0]
    created_files = []

    def cleanup():
        for f in created_files:
            try:
                if os.path.exists(f):
                    os.remove(f)
            except Exception:
                pass
        created_files.clear()

    try:
        wave1 = []
        for idx, off in enumerate(offsets):
            wav = f"{base}_w1_{idx}.wav"
            if extract_pcm_window(video_path, wav, ss=off, t=5.2, af_filter=None, loop_input=is_very_short):
                created_files.append(wav)
                wave1.append(wav)

        res = run_shazam_batch(wave1, country="US")
        if res:
            return res
        cleanup()

        wave2 = []
        eq_filters = [
            ("eq_clean", "highpass=f=120,lowpass=f=7000,dynaudnorm=f=100:g=15"),
            ("eq_vocal", "highpass=f=220,lowpass=f=4500,acompressor=threshold=-18dB:ratio=3,dynaudnorm=f=100:g=15"),
        ]
        sample_points = offsets[:3] if len(offsets) >= 3 else offsets
        for pt_idx, off in enumerate(sample_points):
            for fname, flt in eq_filters:
                wav = f"{base}_w2_{pt_idx}_{fname}.wav"
                if extract_pcm_window(video_path, wav, ss=off, t=5.5, af_filter=flt, loop_input=is_very_short):
                    created_files.append(wav)
                    wave2.append(wav)

        res = run_shazam_batch(wave2, country="GB")
        if res:
            return res
        cleanup()

        wave3 = []
        speed_filters = [
            ("pitch_down_12", "asetrate=16000*0.88,aresample=16000"),
            ("pitch_down_20", "asetrate=16000*0.80,aresample=16000"),
            ("pitch_down_26", "asetrate=16000*0.74,aresample=16000"),
            ("pitch_up_14",   "asetrate=16000*1.14,aresample=16000"),
            ("pitch_up_25",   "asetrate=16000*1.25,aresample=16000"),
            ("tempo_down_15", "atempo=0.85"),
            ("tempo_down_22", "atempo=0.78"),
            ("tempo_up_18",   "atempo=1.18"),
        ]
        for sname, sflt in speed_filters:
            wav = f"{base}_w3_{sname}.wav"
            full_flt = f"{sflt},highpass=f=100,dynaudnorm=f=100:g=15"
            if extract_pcm_window(video_path, wav, ss=mid_offset, t=5.5, af_filter=full_flt, loop_input=True):
                created_files.append(wav)
                wave3.append(wav)

        res = run_shazam_batch(wave3, country="US")
        if res:
            return res
        cleanup()

        if AUDD_API_TOKEN:
            mp3_path = f"{base}_audd.mp3"
            audd_ss = max(0.0, duration / 2.0 - 6.0) if duration > 14 else 0.0
            if extract_mp3_for_audd(video_path, mp3_path, ss=audd_ss, t=12.0):
                created_files.append(mp3_path)
                res = audd_recognize(mp3_path)
                if res:
                    return res

    finally:
        cleanup()

    return None


@bot.message_handler(commands=['start', 'help'])
def send_welcome(message):
    if message.chat.type != 'private':
        return

    save_user(message.from_user.id)
    save_storage_chat_id(message.chat.id)

    if not check_user_subscription(message.from_user.id):
        send_subscription_required(message.chat.id)
        return

    try:
        bot.send_message(
            message.chat.id,
            WELCOME_TEXT_HTML,
            parse_mode="HTML"
        )
    except Exception:
        pass


def clean_search_query(query):
    cleaned = re.sub(
        r'^/?(?:найти|найди|поиск|ищи|скачать|скачай|шазам|shazam|песня|трек|музыка|текст|слова)(?:@\S+)?\s*',
        '',
        query.strip(),
        flags=re.IGNORECASE
    ).strip()
    return cleaned


def clean_track_display_title(raw_title):
    cleaned = re.sub(
        r'(?i)\s*[\(\[](?:official\s*(?:music\s*)?(?:video|audio|lyric\s*video|visualizer)|lyrics?|текст\s*песни|клип|hd|4k|hq|audio|mv|prod\.?[^\)\]]*)[\)\]]',
        '',
        raw_title
    )
    return cleaned.strip() or raw_title.strip()


def split_artist_title(raw_title, fallback_uploader):
    cleaned_title = clean_track_display_title(raw_title)
    uploader = re.sub(r'(?i)\s*-\s*topic$', '', (fallback_uploader or '')).strip()

    for sep in [" — ", " - ", " – "]:
        if sep in cleaned_title:
            parts = cleaned_title.split(sep, 1)
            return parts[0].strip(), parts[1].strip()

    return (uploader or "Artist"), cleaned_title


STOP_WORDS = {
    "но", "что", "как", "это", "все", "всё", "так", "уже", "или", "без",
    "над", "под", "при", "про", "для", "она", "они", "оно", "мне", "меня",
    "тебя", "тебе", "мой", "моя", "мои", "твой", "твоя", "только", "когда",
    "если", "где", "там", "тут", "вот", "даже", "было", "была", "быть"
}


def get_significant_words(text):
    words = re.findall(r'[а-яёa-z0-9]+', text.lower().replace('ё', 'е'))
    return [w for w in words if len(w) >= 4 and w not in STOP_WORDS]


def is_lyrics_actually_matching(query_text, candidate_lyrics):
    if not candidate_lyrics:
        return False
    sig_q = get_significant_words(query_text)
    if not sig_q:
        return False

    norm_lyrics = candidate_lyrics.lower().replace('ё', 'е')
    matched = sum(1 for w in sig_q if w in norm_lyrics)
    ratio = matched / len(sig_q)
    return matched >= min(3, len(sig_q)) and ratio >= 0.65


def search_verified_audd_lyrics(lyrics_text):
    if not AUDD_API_TOKEN:
        return []
    verified = []
    try:
        r = http_session.post(
            "https://api.audd.io/findLyrics/",
            data={"api_token": AUDD_API_TOKEN, "q": lyrics_text},
            timeout=5
        )
        data = r.json()
        for item in (data.get("result") or [])[:5]:
            artist = (item.get("artist") or "").strip()
            title = (item.get("title") or "").strip()
            lyrics_body = item.get("lyrics") or ""
            if artist and title and is_lyrics_actually_matching(lyrics_text, lyrics_body):
                q = f"{artist} - {title}"
                if q not in verified:
                    verified.append(q)
    except Exception as e:
        print(f"[AudD Lyrics Error]: {e}")
    return verified


def _lyric_chunks(text):
    words = re.findall(r'[а-яёa-z0-9]+', text.lower().replace('ё', 'е'))
    if len(words) < 4:
        return [' '.join(words)] if words else []
    mid = len(words) // 2
    chunks = [
        ' '.join(words[:4]),
        ' '.join(words[mid - 2:mid + 2]),
        ' '.join(words[-4:]),
    ]
    return list(dict.fromkeys(chunks))


def search_web_for_song(lyrics_chunk):
    song_queries = []
    search_variants = [
        f'"{lyrics_chunk}" песня',
        f'"{lyrics_chunk}" текст песни',
        f'{lyrics_chunk} песня исполнитель',
    ]
    noise = re.compile(
        r'(?i)\s*(?:[-—|:]\s*)?(?:текст\s+песни|слова\s+песни|lyrics|скачать|слушать|аккорды|перевод|mp3|genius|muzofond).*$'
    )
    for sq in search_variants:
        try:
            r = http_session.get(
                f"https://html.duckduckgo.com/html/?q={quote_plus(sq)}",
                timeout=6
            )
            if r.status_code != 200:
                continue
            titles = re.findall(r'<a[^>]*class="result__a"[^>]*>(.*?)</a>', r.text, flags=re.DOTALL)
            for raw_t in titles[:8]:
                clean_t = re.sub(r'<[^>]+>', '', raw_t).strip()
                clean_t = re.sub(r'\s*-\s*YouTube.*$', '', clean_t, flags=re.IGNORECASE).strip()
                clean_t = noise.sub('', clean_t).strip()
                if any(sep in clean_t for sep in [" - ", " — ", " – "]) and 5 < len(clean_t) < 75:
                    if clean_t not in song_queries:
                        song_queries.append(clean_t)
        except Exception as e:
            print(f"[Web Search Error]: {e}")
    print(f"[Lyrics web] chunk={lyrics_chunk!r} -> {song_queries[:4]}")
    return song_queries[:4]


def is_junk_non_music_video(raw_title, uploader=""):
    combined = f"{raw_title} {uploader}".lower()
    junk_patterns = [
        r'\bcs\s*2\b', r'\bcs:?go\b', r'\bкс\s*2\b', r'\bкс\s*го\b',
        r'\bdota\s*2?\b', r'\bдota\b', r'\bminecraft\b', r'\bмайнкрафт\b',
        r'\broblox\b', r'\bроблокс\b', r'\bvalorant\b', r'\bвалорант\b',
        r'\bstandoff\b', r'\bстандофф\b', r'\bpubg\b', r'\bgta\b', r'\bгта\b',
        r'\bbrawl\s*stars\b', r'\bбравл\b', r'\bfortnite\b', r'\bфортнайт\b',
        r'\bафк\b', r'\bafk\b', r'\blvl\b', r'\bлвл\b',
        r'\bвзломал\b', r'\bскачал\s+всю\b', r'\bмастерскую\b',
        r'\bглавный\s+секрет\b', r'\bпрохождение\b', r'\bлетсплей\b',
        r'\bгайд\b', r'\bтуториал\b', r'\bобзор\b', r'\bстрим\b',
        r'\bkaspi\b', r'\bкаспи\b', r'\bнакопительный\b',
        r'\bbank\s+deposit\b', r'\bsavings\s+account\b', r'\bterm\s+deposit\b',
        r'\bинвестиц\w*\b', r'\bзаработ\w*\b', r'\bмиллиард\w*\b',
        r'\bвысказал(?:ся|ась)\b', r'\bинтервью\b', r'\bновости\b',
        r'\bподкаст\b', r'\bразоблачение\b', r'\bреакция\b',
        r'\bbefore\s+his\s+death\b', r'\breply\s+to\b',
        r'\bpreview\b', r'\bsnippet\b', r'\bdemo\b', r'\bдемо\b',
    ]
    return any(re.search(p, combined) for p in junk_patterns)


def is_music_like_entry(raw_title, uploader, duration):
    if is_junk_non_music_video(raw_title, uploader):
        return False
    if duration > 480 or (0 < duration < 30):
        return False
    return True


def score_music_relevance(track_obj, query_words):
    score = 0
    title_l = track_obj['title'].lower()
    artist_l = track_obj['artist'].lower()
    full_l = f"{artist_l} {title_l}"
    for w in query_words:
        if len(w) >= 2 and w in full_l:
            score += 15
    if any(m in artist_l for m in ["music", "muzic", "records", "official", "prod", "beats", "sound", "topic", "vevo"]):
        score += 14
    dur = track_obj.get('duration') or 0
    if 70 <= dur <= 270:
        score += 8
    elif dur > 330:
        score -= 5
    return score


_lyric_pool = ThreadPoolExecutor(max_workers=8)
_search_outer_pool = ThreadPoolExecutor(max_workers=4)
LYRIC_BUDGET = 12


def build_smart_search_plan(raw_query):
    clean_q = clean_search_query(raw_query) or raw_query.strip()
    words = clean_q.split()
    queries = []

    def add(q):
        if q and q not in queries:
            queries.append(q)

    if len(words) >= 5:
        chunks = _lyric_chunks(clean_q)
        audd_futs = [_lyric_pool.submit(search_verified_audd_lyrics, c) for c in chunks]
        web_futs = [_lyric_pool.submit(search_web_for_song, c) for c in chunks]
        deadline = time.time() + LYRIC_BUDGET

        for f in audd_futs + web_futs:
            try:
                for s in f.result(timeout=max(0.1, deadline - time.time())):
                    add(s)
            except Exception as e:
                print(f"[Lyrics timeout/err]: {e}")

        for chunk in chunks:
            add(chunk)
        add(clean_q)
    else:
        add(clean_q)
        if not any(w in clean_q.lower() for w in ["песня", "трек", "audio"]):
            add(f"{clean_q} песня")

    print(f"[Search plan] {queries[:5]}")
    return queries[:5]


def _append_entry_to_tracks(entry, seen_labels, tracks):
    if not entry:
        return
    raw_title = (entry.get('title') or '').strip()
    uploader = (entry.get('uploader') or entry.get('channel') or '').strip()
    duration = int(entry.get('duration') or 0)

    if not raw_title or not is_music_like_entry(raw_title, uploader, duration):
        return

    url = entry.get('url') or entry.get('webpage_url') or entry.get('id') or ''
    if url and not url.startswith('http'):
        if "soundcloud" in url:
            pass
        else:
            url = f"https://soundcloud.com/{url}"

    thumbs = entry.get('thumbnails') or []
    thumbnail = thumbs[-1].get('url', '') if thumbs else (entry.get('thumbnail') or '')

    if raw_title and url:
        artist, title = split_artist_title(raw_title, uploader)
        display_label = f"{artist} — {title}" if artist.lower() not in title.lower() else title
        norm_key = display_label.lower()
        if norm_key in seen_labels:
            return
        seen_labels.add(norm_key)

        t_id = hashlib.md5(f"{url}_{time.time()}_{len(tracks)}".encode()).hexdigest()[:12]
        track_obj = {
            'id': t_id,
            'title': title,
            'artist': artist,
            'display': display_label,
            'url': url,
            'artwork': thumbnail,
            'duration': duration
        }
        text_search_cache[t_id] = track_obj
        tracks.append(track_obj)


def search_youtube_tracks(query, limit=25):
    tracks = []
    seen_labels = set()
    clean_q = clean_search_query(query) or query.strip()
    query_words = re.findall(r'[а-яёa-z0-9]+', clean_q.lower())
    search_queries = build_smart_search_plan(clean_q)

    ydl_opts = {
        'extract_flat': 'in_playlist',
        'noplaylist': True,
        'quiet': True,
        'no_warnings': True,
    }

    with YoutubeDL(ydl_opts) as ydl:
        for sq in search_queries:
            try:
                info = ydl.extract_info(f"scsearch10:{sq}", download=False)
                entries = info.get('entries', []) if info else []
                for entry in entries:
                    _append_entry_to_tracks(entry, seen_labels, tracks)
            except Exception as e:
                print(f"[SoundCloud Search Error]: {e}")
            if len(tracks) >= limit:
                break

    tracks.sort(key=lambda t: score_music_relevance(t, query_words), reverse=True)
    return tracks[:limit]


def build_search_keyboard(session_id, page=0, per_page=9):
    session = search_session_cache.get(session_id)
    if not session:
        return None

    tracks = session['tracks']
    owner_id = session.get('user_id', 0)
    start = page * per_page
    end = start + per_page
    slice_tracks = tracks[start:end]

    markup = types.InlineKeyboardMarkup(row_width=1)

    for idx, track in enumerate(slice_tracks):
        dur = track['duration']
        dur_str = f"{dur // 60}:{dur % 60:02d}" if dur > 0 else ""

        if idx == 0 and dur_str:
            btn_text = f"• {dur_str} • {track['display']}"
        elif dur_str:
            btn_text = f"{track['display']} ({dur_str})"
        else:
            btn_text = track['display']

        if len(btn_text) > 58:
            btn_text = btn_text[:55] + "..."

        markup.add(types.InlineKeyboardButton(btn_text, callback_data=f"pick:{track['id']}:{owner_id}"))

    if end < len(tracks):
        next_page = page + 1
        try:
            more_btn = types.InlineKeyboardButton("➕ Больше треков", callback_data=f"more:{session_id}:{next_page}", style="success")
        except TypeError:
            more_btn = types.InlineKeyboardButton("➕ Больше треков", callback_data=f"more:{session_id}:{next_page}")
        markup.add(more_btn)

    return markup


def show_track_selection(message, query_text, status_msg=None, owner_id=None):
    chat_id = message.chat.id
    user_id = owner_id if owner_id is not None else (message.from_user.id if message.from_user else 0)
    if not status_msg:
        status_msg = safe_reply(message, f"{E_SEARCH}", parse_mode="HTML", reply_markup=None)
    if not status_msg:
        return

    def do_search():
        try:
            fut = _search_outer_pool.submit(search_youtube_tracks, query_text, 25)
            try:
                tracks = fut.result(timeout=60)
            except Exception as e:
                print(f"[Search timeout]: {e}")
                tracks = []
            if not tracks:
                safe_edit(f"{E_CROSS} Ничего не найдено", chat_id, status_msg.message_id, parse_mode="HTML")
                return

            session_id = hashlib.md5(f"{chat_id}_{status_msg.message_id}_{query_text}".encode()).hexdigest()[:12]
            search_session_cache[session_id] = {
                'query': query_text,
                'tracks': tracks,
                'user_id': user_id
            }

            markup = build_search_keyboard(session_id, page=0, per_page=9)
            safe_edit(
                f"{E_MUSIC} Найдено по запросу: <b>{query_text}</b>",
                chat_id,
                status_msg.message_id,
                parse_mode="HTML",
                reply_markup=markup
            )
        except Exception:
            traceback.print_exc()
            safe_edit(f"{E_CROSS} Ошибка поиска", chat_id, status_msg.message_id, parse_mode="HTML")

    threading.Thread(target=do_search, daemon=True).start()


@bot.callback_query_handler(func=lambda call: call.data.startswith("more:"))
def handle_more_tracks(call):
    parts = call.data.split(":")
    session_id = parts[1]
    page = int(parts[2])
    chat_id = call.message.chat.id

    session = search_session_cache.get(session_id)
    if not session:
        bot.answer_callback_query(call.id, "❌ Поиск устарел, повтори запрос")
        return

    owner_id = session.get('user_id', 0)
    if call.message.chat.type != 'private' and owner_id and call.from_user.id != owner_id:
        bot.answer_callback_query(call.id, "❌ Это меню поиска вызвал другой пользователь!", show_alert=True)
        return

    markup = build_search_keyboard(session_id, page=page, per_page=9)
    if not markup:
        bot.answer_callback_query(call.id, "Больше треков нет")
        return

    bot.answer_callback_query(call.id)
    try:
        bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=markup)
    except Exception:
        pass


@bot.callback_query_handler(func=lambda call: call.data.startswith("pick:"))
def handle_picked_track(call):
    parts = call.data.split(":")
    track_id = parts[1]
    owner_id = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else 0

    if call.message.chat.type != 'private' and owner_id and call.from_user.id != owner_id:
        bot.answer_callback_query(call.id, "❌ Вы не можете выбрать трек из чужого поиска!", show_alert=True)
        return

    if call.message.chat.type == 'private' and not check_user_subscription(call.from_user.id):
        bot.answer_callback_query(call.id, "❌ Требуется подписка на новости!", show_alert=True)
        send_subscription_required(call.message.chat.id)
        return

    track_info = text_search_cache.get(track_id)
    if not track_info:
        bot.answer_callback_query(call.id, "❌ Поиск устарел, введи запрос заново")
        return

    bot.answer_callback_query(call.id, f"⏳ Скачиваю: {track_info['title']}")

    chat_id = call.message.chat.id
    reply_target = call.message.reply_to_message.message_id if call.message.reply_to_message else None

    try:
        bot.delete_message(chat_id, call.message.message_id)
    except Exception:
        pass

    def do_download():
        song_path = None
        try:
            fallback_q = f"{track_info.get('artist', '')} {track_info.get('title', '')}".strip()
            dl_res = download_song_ytdlp(track_info['url'], fallback_search_query=fallback_q)
            if not dl_res or not os.path.exists(dl_res['path']):
                bot.send_message(chat_id, f"{E_CROSS} Не удалось скачать трек", parse_mode="HTML", reply_to_message_id=reply_target)
                return

            song_path = dl_res['path']
            send_downloaded_song(
                chat_id,
                reply_target,
                dl_res,
                override_title=track_info['title'],
                override_artist=track_info['artist'],
                override_art=track_info.get('artwork')
            )
        except Exception:
            traceback.print_exc()
            try:
                bot.send_message(chat_id, f"{E_CROSS} Ошибка при отправке трека (превышен лимит ожидания сети)", parse_mode="HTML")
            except Exception:
                pass
        finally:
            if song_path and os.path.exists(song_path):
                try:
                    os.remove(song_path)
                except Exception:
                    pass

    threading.Thread(target=do_download, daemon=True).start()


def _finalize_downloaded_audio(ydl, info):
    if not info:
        return None
    if 'entries' in info:
        entries = [e for e in info['entries'] if e]
        if not entries:
            return None
        info = entries[0]

    filename = ydl.prepare_filename(info)
    base, _ = os.path.splitext(filename)

    final_path = None
    for ext in [".mp3", ".m4a", ".ogg", ".opus", ".webm", ".wav", ".aac"]:
        if os.path.exists(base + ext):
            final_path = base + ext
            break
    if not final_path and os.path.exists(filename):
        final_path = filename

    if final_path and final_path.endswith((".webm", ".opus", ".wav", ".aac")):
        mp3_out = base + ".mp3"
        subprocess.run(
            [FFMPEG_PATH, "-y", "-i", final_path, "-vn", "-acodec", "libmp3lame", "-q:a", "4", mp3_out],
            capture_output=True, timeout=40
        )
        if os.path.exists(mp3_out):
            try:
                os.remove(final_path)
            except Exception:
                pass
            final_path = mp3_out

    if final_path and os.path.exists(final_path) and os.path.getsize(final_path) > 25000:
        raw_title = (info.get('title') or '').strip()
        uploader = (info.get('artist') or info.get('uploader') or info.get('channel') or '').strip()
        artist, title = split_artist_title(raw_title, uploader)
        if info.get('track') and info.get('artist'):
            title = info.get('track')
            artist = info.get('artist')

        thumbs = info.get('thumbnails') or []
        thumb = info.get('thumbnail') or (thumbs[-1].get('url', '') if thumbs else '')
        return {
            'path': final_path,
            'title': title,
            'artist': artist,
            'thumbnail': thumb
        }
    return None


def download_song_ytdlp(query_or_url, fallback_search_query=None):
    h = hashlib.md5(f"{query_or_url}_{time.time()}".encode()).hexdigest()[:10]
    out_path = os.path.join(DOWNLOAD_DIR, f"song_{h}.%(ext)s")

    target = query_or_url
    if not target.startswith('http'):
        target = f"scsearch1:{query_or_url}"

    ydl_opts = {
        'format': 'bestaudio[ext=m4a]/bestaudio[ext=mp3]/bestaudio/best',
        'outtmpl': out_path,
        'noplaylist': True,
        'quiet': True,
        'no_warnings': True,
        'noprogress': True,
        'ffmpeg_location': FFMPEG_PATH,
        'socket_timeout': 15,
        'retries': 2,
    }

    try:
        with YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(target, download=True)
            res = _finalize_downloaded_audio(ydl, info)
            if res:
                return res
    except Exception as e:
        print(f"[SoundCloud Download Error]: {e}")

    sc_query = fallback_search_query or (query_or_url if not query_or_url.startswith("http") else "")
    if sc_query:
        try:
            with YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(f"scsearch1:{sc_query}", download=True)
                res = _finalize_downloaded_audio(ydl, info)
                if res:
                    return res
        except Exception as e:
            print(f"[SoundCloud Fallback Error]: {e}")

    return None


def _normalize_to_mp3(src: str) -> str:
    dst = os.path.splitext(src)[0] + "_clean.mp3"
    cmd = [
        FFMPEG_PATH, "-y", "-i", src,
        "-vn", "-map_metadata", "-1",
        "-c:a", "libmp3lame", "-b:a", "192k",
        "-ar", "44100", "-ac", "2",
        dst
    ]
    r = subprocess.run(cmd, capture_output=True, timeout=120)
    if r.returncode == 0 and os.path.exists(dst) and os.path.getsize(dst) > 25000:
        try:
            os.remove(src)
        except Exception:
            pass
        return dst
    raise RuntimeError(f"ffmpeg normalize failed: {r.stderr[-300:] if r.stderr else ''}")


def _make_thumb_jpeg(raw: bytes):
    try:
        img = Image.open(io.BytesIO(raw)).convert("RGB")
        img.thumbnail((320, 320), Image.Resampling.LANCZOS)
        for q in (90, 80, 70, 60):
            buf = io.BytesIO()
            img.save(buf, format="JPEG", quality=q, optimize=True)
            if buf.tell() < 200 * 1024:
                return buf.getvalue()
    except Exception as e:
        print(f"[Thumb Error]: {e}")
    return None


def _probe(path: str) -> str:
    try:
        r = subprocess.run(
            [FFMPEG_PATH, "-hide_banner", "-i", path],
            capture_output=True, text=True, timeout=15
        )
        lines = [l.strip() for l in r.stderr.splitlines() if "Duration" in l or "Stream #" in l]
        return f"size={os.path.getsize(path)} | " + " | ".join(lines)
    except Exception as e:
        return f"probe failed: {e}"


def send_downloaded_song(chat_id, reply_to_message_id, dl_res, override_title=None, override_artist=None, override_art=None):
    clean_path = None
    try:
        clean_path = _normalize_to_mp3(dl_res['path'])
        print(f"[send probe] {_probe(clean_path)}")

        thumb_bytes = None
        art_url = override_art or dl_res.get('thumbnail')
        if art_url:
            try:
                r = http_session.get(art_url, timeout=5)
                if r.status_code == 200 and r.content:
                    thumb_bytes = _make_thumb_jpeg(r.content)
            except Exception:
                pass

        title = override_title or dl_res.get('title') or "Track"
        performer = override_artist or dl_res.get('artist') or "Artist"
        fname = f"{performer} - {title}.mp3"[:120]

        def _try(label, fn):
            try:
                fn()
                print(f"[send ok] {label}")
                return True
            except Exception as e:
                print(f"[send fail] {label}: {e}")
                return False

        def v_full():
            with open(clean_path, "rb") as f:
                bot.send_audio(chat_id, types.InputFile(f, file_name=fname),
                               title=title, performer=performer,
                               caption="вот ваш найденный трек! Приятного прослушивания",
                               thumbnail=types.InputFile(io.BytesIO(thumb_bytes), file_name="thumb.jpg") if thumb_bytes else None,
                               reply_to_message_id=reply_to_message_id,
                               allow_sending_without_reply=True, timeout=120)

        def v_no_caption():
            with open(clean_path, "rb") as f:
                bot.send_audio(chat_id, types.InputFile(f, file_name=fname),
                               title=title, performer=performer,
                               reply_to_message_id=reply_to_message_id,
                               allow_sending_without_reply=True, timeout=120)

        def v_bare():
            with open(clean_path, "rb") as f:
                bot.send_audio(chat_id, types.InputFile(f, file_name=fname),
                               reply_to_message_id=reply_to_message_id,
                               allow_sending_without_reply=True, timeout=120)

        def v_document():
            with open(clean_path, "rb") as f:
                bot.send_document(chat_id, types.InputFile(f, file_name=fname),
                                  caption=TRACK_CAPTION_HTML, parse_mode="HTML",
                                  reply_to_message_id=reply_to_message_id,
                                  allow_sending_without_reply=True, timeout=120)

        for label, fn in [
            ("audio full", v_full),
            ("audio no_caption", v_no_caption),
            ("audio bare", v_bare),
            ("document", v_document),
        ]:
            if _try(label, fn):
                return

        raise RuntimeError("все варианты отправки не прошли, см. [send fail] в логе")
    finally:
        if clean_path and os.path.exists(clean_path):
            try:
                os.remove(clean_path)
            except Exception:
                pass


def recognize_and_show_options(message, status_msg, media_path, delete_source=False, owner_id=None):
    chat_id = message.chat.id
    msg_id = status_msg.message_id if status_msg else None
    try:
        result = extract_and_recognize(media_path)
        if not result or not result.get("title"):
            safe_edit(f"{E_CROSS} Не удалось определить музыку", chat_id, msg_id, parse_mode="HTML")
            return

        query = f"{result['artist']} — {result['title']}"
        show_track_selection(message, query, status_msg=status_msg, owner_id=owner_id)
    except Exception:
        traceback.print_exc()
        safe_edit(f"{E_CROSS} Ошибка при определении музыки", chat_id, msg_id, parse_mode="HTML")
    finally:
        if delete_source and media_path and os.path.exists(media_path):
            try:
                os.remove(media_path)
            except Exception:
                pass


@bot.callback_query_handler(func=lambda call: call.data.startswith("shazam:"))
def handle_shazam(call):
    if call.message.chat.type == 'private' and not check_user_subscription(call.from_user.id):
        bot.answer_callback_query(call.id, "❌ Требуется подписка на новости!", show_alert=True)
        send_subscription_required(call.message.chat.id)
        return

    video_id = call.data.split(":", 1)[1]
    chat_id = call.message.chat.id
    video_path = shazam_video_cache.get(video_id)

    if not video_path or not os.path.exists(video_path):
        bot.answer_callback_query(call.id, "❌ Видео уже удалено, скачай заново")
        return

    bot.answer_callback_query(call.id, "🎵 Определяю музыку...")

    try:
        bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=None)
    except Exception:
        pass

    try:
        status_msg = bot.send_message(
            chat_id,
            f"{E_SEARCH}",
            parse_mode="HTML",
            reply_to_message_id=call.message.reply_to_message.message_id if call.message.reply_to_message else call.message.message_id
        )
    except Exception:
        return

    threading.Thread(
        target=recognize_and_show_options,
        args=(call.message, status_msg, video_path, False, call.from_user.id),
        daemon=True
    ).start()


def extract_telegram_media_file_id(msg):
    if not msg:
        return None
    if msg.video:
        return msg.video.file_id
    if msg.video_note:
        return msg.video_note.file_id
    if msg.voice:
        return msg.voice.file_id
    if msg.audio:
        return msg.audio.file_id
    if msg.document and msg.document.mime_type and (
        msg.document.mime_type.startswith("video/") or msg.document.mime_type.startswith("audio/")
    ):
        return msg.document.file_id
    return None


def handle_telegram_media_shazam(message, target_msg, existing_status_msg=None, requester_id=None):
    chat_id = message.chat.id
    req_id = requester_id if requester_id is not None else (message.from_user.id if message.from_user else 0)
    file_id = extract_telegram_media_file_id(target_msg)
    if not file_id:
        return

    status_msg = existing_status_msg or safe_reply(target_msg, f"{E_SEARCH}", parse_mode="HTML")
    if not status_msg:
        return

    def worker():
        local_path = os.path.join(DOWNLOAD_DIR, f"tg_media_{chat_id}_{target_msg.message_id}_{int(time.time())}.mp4")
        try:
            file_info = bot.get_file(file_id)
            downloaded = bot.download_file(file_info.file_path)
            with open(local_path, "wb") as f:
                f.write(downloaded)
            recognize_and_show_options(target_msg, status_msg, local_path, delete_source=True, owner_id=req_id)
        except Exception:
            traceback.print_exc()
            safe_edit(f"{E_CROSS} Не удалось обработать файл", chat_id, status_msg.message_id, parse_mode="HTML")
            if os.path.exists(local_path):
                try:
                    os.remove(local_path)
                except Exception:
                    pass

    threading.Thread(target=worker, daemon=True).start()


def _prompt_button(text, callback_data, icon_id):
    try:
        return types.InlineKeyboardButton(text, callback_data=callback_data, icon_custom_emoji_id=icon_id)
    except TypeError:
        return types.InlineKeyboardButton(text, callback_data=callback_data)


def ask_group_shazam_confirmation(message):
    file_id = extract_telegram_media_file_id(message)
    if not file_id:
        return

    prompt_key = hashlib.md5(f"{message.chat.id}_{message.message_id}_{time.time()}".encode()).hexdigest()[:12]
    group_media_prompt_cache[prompt_key] = {
        "target_msg": message,
        "owner_id": message.from_user.id if message.from_user else 0
    }

    markup = types.InlineKeyboardMarkup(row_width=2)
    btn_yes = _prompt_button("Определить", f"grp_shz_y:{prompt_key}", "5895514131896733546")
    btn_no = _prompt_button("Не нужно", f"grp_shz_n:{prompt_key}", "5893163582194978381")
    markup.add(btn_yes, btn_no)

    sent = safe_reply(
        message,
        f"{E_MUSIC} <b>Нужно ли определить музыку у данного файла?</b>",
        parse_mode="HTML",
        reply_markup=markup
    )
    if sent and prompt_key in group_media_prompt_cache:
        group_media_prompt_cache[prompt_key]["timer"] = schedule_delete(sent.chat.id, sent.message_id)


@bot.callback_query_handler(func=lambda call: call.data.startswith(("grp_shz_y:", "grp_shz_n:")))
def handle_group_shazam_prompt(call):
    action, prompt_key = call.data.split(":", 1)
    data = group_media_prompt_cache.get(prompt_key)

    if not data:
        bot.answer_callback_query(call.id, "❌ Запрос устарел")
        try:
            bot.delete_message(call.message.chat.id, call.message.message_id)
        except Exception:
            pass
        return

    timer = data.get("timer")
    if timer:
        timer.cancel()

    if action == "grp_shz_n":
        owner_id = data.get("owner_id", 0)
        if owner_id and call.from_user.id != owner_id and call.from_user.id != ADMIN_USER_ID:
            bot.answer_callback_query(call.id, "❌ Отклонить может только отправитель сообщения!", show_alert=True)
            return
        group_media_prompt_cache.pop(prompt_key, None)
        bot.answer_callback_query(call.id, "Скрыто")
        try:
            bot.delete_message(call.message.chat.id, call.message.message_id)
        except Exception:
            pass
        return

    group_media_prompt_cache.pop(prompt_key, None)
    bot.answer_callback_query(call.id, "🔎 Запускаю распознавание...")
    target_msg = data["target_msg"]
    safe_edit(f"{E_SEARCH}", call.message.chat.id, call.message.message_id, parse_mode="HTML", reply_markup=None)
    handle_telegram_media_shazam(
        target_msg,
        target_msg,
        existing_status_msg=call.message,
        requester_id=call.from_user.id
    )


@bot.message_handler(content_types=['video', 'video_note', 'voice', 'audio', 'document'])
def handle_direct_media(message):
    file_id = extract_telegram_media_file_id(message)
    if not file_id:
        return

    is_private = message.chat.type == 'private'
    if is_private:
        save_user(message.from_user.id)
        if not check_user_subscription(message.from_user.id):
            send_subscription_required(message.chat.id, reply_to_message_id=message.message_id)
            return
        handle_telegram_media_shazam(message, message)
        return

    caption = (message.caption or '').strip()
    is_trigger = bool(re.match(r'^/?(?:найти|найди|шазам|shazam|трек|песня|музыка)\b', caption, flags=re.IGNORECASE))

    if is_trigger:
        handle_telegram_media_shazam(message, message)
    elif message.video or message.video_note or message.voice:
        ask_group_shazam_confirmation(message)


def unwrap_redirect_url(raw_url):
    url = raw_url.strip()
    try:
        parsed = urlparse(url)
        host = (parsed.hostname or "").lower()
        if any(g in host for g in ("google.", "yandex.", "vk.com", "l.instagram.com", "t.umblr.com")):
            qs = parse_qs(parsed.query)
            for key in ("url", "q", "u", "to", "target"):
                if key in qs and qs[key]:
                    cand = unquote(qs[key][0]).strip()
                    if cand.startswith("http"):
                        return cand
    except Exception:
        pass
    return url


def download_tiktok_media(url, unique_id):
    real_url = url
    try:
        r_head = http_session.head(url, allow_redirects=True, timeout=6)
        if r_head.url:
            real_url = r_head.url
    except Exception:
        try:
            r_get = http_session.get(url, allow_redirects=True, timeout=6, stream=True)
            if r_get.url:
                real_url = r_get.url
            r_get.close()
        except Exception:
            pass

    for target_u in (real_url, url):
        try:
            res = http_session.post(
                "https://www.tikwm.com/api/",
                data={"url": target_u, "hd": 1},
                timeout=10
            ).json()
            if res.get("code") == 0 and res.get("data"):
                data = res["data"]
                title = data.get("title") or ""

                images = data.get("images")
                if isinstance(images, list) and len(images) > 0:
                    photo_paths = []
                    for idx, img_url in enumerate(images[:10]):
                        try:
                            ir = http_session.get(img_url, timeout=12)
                            if ir.status_code == 200 and len(ir.content) > 1000:
                                p_path = os.path.join(DOWNLOAD_DIR, f"{unique_id}_tt_img_{idx}.jpg")
                                with open(p_path, "wb") as f:
                                    f.write(ir.content)
                                photo_paths.append(p_path)
                        except Exception:
                            pass
                    if photo_paths:
                        return {
                            "type": "photos",
                            "paths": photo_paths,
                            "title": title,
                        }

                video_url = data.get("hdplay") or data.get("play") or data.get("wmplay")
                if video_url:
                    if video_url.startswith("/"):
                        video_url = "https://www.tikwm.com" + video_url
                    r = http_session.get(video_url, timeout=20)
                    if r.status_code == 200 and len(r.content) > 10000:
                        out_p = os.path.join(DOWNLOAD_DIR, f"{unique_id}_tiktok.mp4")
                        with open(out_p, "wb") as f:
                            f.write(r.content)
                        return {
                            "type": "video",
                            "path": out_p,
                            "title": title,
                        }
        except Exception as e:
            print(f"[TikWM Error]: {e}")

    vid_match = re.search(r'/(?:video|photo)/(\d+)', real_url) or re.search(r'(\d{17,20})', real_url)
    if vid_match:
        vid_id = vid_match.group(1)
        direct_mirrors = [
            f"https://d.tnktok.com/video/{vid_id}.mp4",
            f"https://tikwm.com/video/media/play/{vid_id}.mp4",
            f"https://tikwm.com/video/media/hdplay/{vid_id}.mp4",
        ]
        for mirror_url in direct_mirrors:
            try:
                r = http_session.get(mirror_url, allow_redirects=True, timeout=15)
                ctype = (r.headers.get("Content-Type") or "").lower()
                if r.status_code == 200 and len(r.content) > 20000 and ("video" in ctype or "octet-stream" in ctype):
                    out_p = os.path.join(DOWNLOAD_DIR, f"{unique_id}_tiktok.mp4")
                    with open(out_p, "wb") as f:
                        f.write(r.content)
                    return {
                        "type": "video",
                        "path": out_p,
                        "title": "",
                    }
            except Exception:
                pass

    return None


def download_instagram_fallback(url, unique_id):
    clean_u = url.split("?")[0].rstrip("/")
    m = re.search(r'instagram\.com/(?:p|reel|reels|tv)/([A-Za-z0-9_-]+)', clean_u)
    if m:
        shortcode = m.group(1)
        dd_url = f"https://www.ddinstagram.com/p/{shortcode}/"
        try:
            r = http_session.get(dd_url, headers=HEADERS, timeout=12)
            html = r.text
            vid_m = re.search(r'<meta\s+[^>]*property=["\']og:video(?::secure_url)?["\'][^>]*content=["\']([^"\']+)["\']', html, re.I)
            if vid_m:
                v_url = vid_m.group(1).replace("&amp;", "&")
                if v_url.startswith("/"):
                    v_url = "https://www.ddinstagram.com" + v_url
                vr = http_session.get(v_url, timeout=15)
                if vr.status_code == 200 and len(vr.content) > 5000:
                    out_p = os.path.join(DOWNLOAD_DIR, f"{unique_id}_ig.mp4")
                    with open(out_p, "wb") as f:
                        f.write(vr.content)
                    return {"path": out_p, "title": "", "thumbnail": "", "ext": "mp4"}

            img_m = re.search(r'<meta\s+[^>]*property=["\']og:image["\'][^>]*content=["\']([^"\']+)["\']', html, re.I)
            if img_m:
                i_url = img_m.group(1).replace("&amp;", "&")
                if i_url.startswith("/"):
                    i_url = "https://www.ddinstagram.com" + i_url
                ir = http_session.get(i_url, timeout=12)
                if ir.status_code == 200 and len(ir.content) > 2000:
                    out_p = os.path.join(DOWNLOAD_DIR, f"{unique_id}_ig.jpg")
                    with open(out_p, "wb") as f:
                        f.write(ir.content)
                    return {"path": out_p, "title": "", "thumbnail": "", "ext": "jpg"}
        except Exception:
            pass
    return None


def download_universal_web_media(url, unique_id):
    if "instagram.com" in url.lower():
        ig_res = download_instagram_fallback(url, unique_id)
        if ig_res:
            return ig_res

    try:
        r = http_session.get(url, allow_redirects=True, timeout=15, stream=True)
        if r.status_code != 200:
            return None

        ctype = (r.headers.get("Content-Type") or "").lower()

        if any(k in ctype for k in ["image/gif", "image/jpeg", "image/png", "image/webp", "video/mp4", "video/webm"]):
            raw_data = r.content
            if len(raw_data) < 500:
                return None
            if "gif" in ctype:
                ext = "gif"
            elif "png" in ctype:
                ext = "png"
            elif "webp" in ctype:
                ext = "webp"
            elif "mp4" in ctype:
                ext = "mp4"
            elif "webm" in ctype:
                ext = "webm"
            else:
                ext = "jpg"

            out_path = os.path.join(DOWNLOAD_DIR, f"{unique_id}_direct.{ext}")
            with open(out_path, "wb") as f:
                f.write(raw_data)
            return {"path": out_path, "title": "", "thumbnail": "", "ext": ext}

        html = r.text

        mp4_matches = (
            re.findall(r'https://v1\.pinimg\.com/videos/[^\s"\'<>]+\.mp4', html) +
            re.findall(r'https://media\.tenor\.com/[^\s"\'<>]+\.mp4', html) +
            re.findall(r'https://i\.imgur\.com/[^\s"\'<>]+\.mp4', html)
        )
        if mp4_matches:
            video_url = mp4_matches[0].replace("\\u002F", "/")
            vr = http_session.get(video_url, timeout=15)
            if vr.status_code == 200 and len(vr.content) > 2000:
                is_gif_host = any(h in url.lower() for h in ("tenor.com", "giphy.com", "imgur.com"))
                out_path = os.path.join(DOWNLOAD_DIR, f"{unique_id}_web.mp4")
                with open(out_path, "wb") as f:
                    f.write(vr.content)
                return {"path": out_path, "title": "", "thumbnail": "", "ext": "gif" if is_gif_host else "mp4"}

        gif_matches = (
            re.findall(r'https://media\d*\.giphy\.com/media/[^\s"\'<>]+\.gif', html) +
            re.findall(r'https://c\.tenor\.com/[^\s"\'<>]+\.gif', html) +
            re.findall(r'https://media\.tenor\.com/[^\s"\'<>]+\.gif', html)
        )
        if gif_matches:
            gif_url = gif_matches[0].replace("\\u002F", "/")
            gr = http_session.get(gif_url, timeout=15)
            if gr.status_code == 200 and len(gr.content) > 2000:
                out_path = os.path.join(DOWNLOAD_DIR, f"{unique_id}_anim.gif")
                with open(out_path, "wb") as f:
                    f.write(gr.content)
                return {"path": out_path, "title": "", "thumbnail": "", "ext": "gif"}

        og_video = (
            re.search(r'<meta\s+[^>]*property=["\']og:video(?::secure_url|:url)?["\'][^>]*content=["\']([^"\']+)["\']', html, re.I) or
            re.search(r'<meta\s+[^>]*content=["\']([^"\']+)["\'][^>]*property=["\']og:video(?::secure_url|:url)?["\']', html, re.I)
        )
        if og_video:
            v_url = og_video.group(1).replace("&amp;", "&")
            if v_url.startswith("http") and any(ext in v_url.lower() for ext in (".mp4", ".gif", ".webm")):
                vr = http_session.get(v_url, timeout=15)
                if vr.status_code == 200 and len(vr.content) > 4000:
                    is_gif = ".gif" in v_url.lower() or "tenor" in v_url.lower() or "giphy" in v_url.lower()
                    out_path = os.path.join(DOWNLOAD_DIR, f"{unique_id}_og.{'gif' if is_gif else 'mp4'}")
                    with open(out_path, "wb") as f:
                        f.write(vr.content)
                    return {"path": out_path, "title": "", "thumbnail": "", "ext": "gif" if is_gif else "mp4"}

        img_match = (
            re.search(r'https://i\.pinimg\.com/originals/[^\s"\'<>]+\.(?:jpg|png|gif|webp)', html) or
            re.search(r'<meta\s+[^>]*property=["\']og:image["\'][^>]*content=["\']([^"\']+)["\']', html, re.I) or
            re.search(r'<meta\s+[^>]*content=["\']([^"\']+)["\'][^>]*property=["\']og:image["\']', html, re.I) or
            re.search(r'<meta\s+[^>]*name=["\']twitter:image["\'][^>]*content=["\']([^"\']+)["\']', html, re.I)
        )
        if img_match:
            img_url = (img_match.group(1) if img_match.lastindex else img_match.group(0)).replace("&amp;", "&")
            ir = http_session.get(img_url, timeout=12)
            if ir.status_code == 200 and len(ir.content) > 2000:
                ct = (ir.headers.get("Content-Type") or "").lower()
                ext = img_url.split("?")[0].split(".")[-1].lower()
                if "gif" in ct or ext == "gif":
                    ext = "gif"
                elif ext not in ["jpg", "jpeg", "png", "gif", "webp"]:
                    ext = "jpg"
                out_path = os.path.join(DOWNLOAD_DIR, f"{unique_id}_img.{ext}")
                with open(out_path, "wb") as f:
                    f.write(ir.content)
                return {"path": out_path, "title": "", "thumbnail": "", "ext": ext}
    except Exception:
        traceback.print_exc()
    return None


def download_via_ytdlp(url, output_template):
    if "pinterest." in url:
        url = re.sub(r'https?://([a-z]{2}\.)?pinterest\.[a-z.]+/', 'https://www.pinterest.com/', url)

    ydl_opts = {
        'format': 'bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/bestvideo*+bestaudio/best',
        'outtmpl': output_template,
        'merge_output_format': 'mp4',
        'noplaylist': True,
        'quiet': True,
        'no_warnings': True,
        'noprogress': True,
        'ffmpeg_location': FFMPEG_PATH,
        'concurrent_fragment_downloads': 8,
        'buffersize': 1024 * 64,
        'socket_timeout': 15,
        'retries': 3,
        'http_headers': HEADERS,
        'geo_bypass': True,
        **_get_base_ytdlp_opts(),
    }

    with YoutubeDL(ydl_opts) as ydl:
        info = ydl.extract_info(url, download=True)
        if 'entries' in info and info['entries']:
            info = info['entries'][0]

        filename = ydl.prepare_filename(info)
        if not os.path.exists(filename):
            base, _ = os.path.splitext(filename)
            for ext_cand in [".mp4", ".mkv", ".webm", ".gif", ".jpg", ".png", ".webp", ".m4a", ".mp3"]:
                if os.path.exists(base + ext_cand):
                    filename = base + ext_cand
                    break

        actual_ext = os.path.splitext(filename)[1].lstrip('.').lower() or info.get("ext", "mp4")
        return {
            "path": filename,
            "title": info.get("title", ""),
            "thumbnail": info.get("thumbnail", ""),
            "ext": actual_ext,
            "duration": info.get("duration") or 0
        }


def detect_platform(url):
    u = url.lower()
    if "tiktok.com" in u:                 return "TikTok"
    if "instagram.com" in u:              return "Instagram"
    if "pinterest" in u or "pin.it" in u:     return "Pinterest"
    if "soundcloud.com" in u or "snd.sc" in u: return "SoundCloud"
    if "youtube.com" in u or "youtu.be" in u: return "YouTube"
    if "twitter.com" in u or "x.com" in u:    return "Twitter/X"
    if "tenor.com" in u:                  return "Tenor"
    if "giphy.com" in u:                  return "Giphy"
    if "imgur.com" in u:                  return "Imgur"
    if "reddit.com" in u or "redd.it" in u:   return "Reddit"
    if "vk.com" in u or "vkvideo.ru" in u:    return "VK"
    if "coub.com" in u:                   return "Coub"
    if "9gag.com" in u:                   return "9GAG"
    return "Источник"


SUPPORTED_DOMAINS = (
    "tiktok.com", "instagram.com", "pin.it",
    "soundcloud.com", "snd.sc", "youtube.com", "youtu.be", "twitter.com", "x.com",
    "tenor.com", "giphy.com", "gfycat.com", "imgur.com", "reddit.com", "redd.it",
    "vk.com", "vkvideo.ru", "coub.com", "9gag.com", "joyreactor.cc", "pikabu.ru",
    "twitch.tv", "dailymotion.com", "vimeo.com", "likee.video", "kwai.com",
    "threads.net", "bsky.app", "tumblr.com", "flickr.com", "deviantart.com",
    "artstation.com", "unsplash.com", "pexels.com",
)


def is_supported_url(url):
    url = unwrap_redirect_url(url)
    try:
        parsed = urlparse(url)
        host = (parsed.hostname or "").lower()
        path = (parsed.path or "").lower()
    except Exception:
        return False
    if not host:
        return False
    if "pinterest." in host:
        return True
    if any(path.endswith(ext) for ext in (".gif", ".mp4", ".webm", ".jpg", ".jpeg", ".png", ".webp")):
        return True
    return any(host == d or host.endswith("." + d) for d in SUPPORTED_DOMAINS)


def clean_title(title):
    if not title:
        return ""
    title = re.sub(r'(?i)pinterest\s+video\s*#?\s*\d+', '', title)
    title = re.sub(r'(?i)instagram\s+(reels?\s+)?video\s*#?\s*\d+', '', title)
    title = re.sub(r'(?i)tiktok\s+video\s*#?\s*\d+', '', title)
    title = re.sub(r'^\s*#?\d{10,}\s*$', '', title)
    return title.strip()


def make_shazam_markup(video_path):
    vid_id = hashlib.md5(video_path.encode()).hexdigest()[:16]
    shazam_video_cache[vid_id] = video_path
    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🎵 Определить музыку", callback_data=f"shazam:{vid_id}"))
    return markup


@bot.callback_query_handler(func=lambda call: call.data.startswith("desc_copy:"))
def handle_desc_copy(call):
    user_id = call.from_user.id
    chat_id = call.message.chat.id
    is_group = call.message.chat.type != 'private'

    if is_group:
        last_time = desc_cooldown_cache.get((chat_id, user_id), 0)
        if time.time() - last_time < 300:
            remaining = int(300 - (time.time() - last_time))
            bot.answer_callback_query(call.id, f"❌ Подождите {remaining} сек. перед следующим запросом описания!", show_alert=True)
            return

    desc_id = call.data.split(":", 1)[1]
    data = desc_copy_cache.get(desc_id)

    if not data:
        bot.answer_callback_query(call.id, "❌ Описание устарело", show_alert=True)
        return

    text = data.get('text', '')
    if not text:
        bot.answer_callback_query(call.id, "❌ Описание пустое", show_alert=True)
        return

    if is_group:
        desc_cooldown_cache[(chat_id, user_id)] = time.time()

    bot.answer_callback_query(call.id, "✅ Отправляю описание...")
    try:
        bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=None)
    except Exception:
        pass

    reply_to_id = call.message.reply_to_message.message_id if call.message.reply_to_message else call.message.message_id
    if len(text) > 1000:
        file_name = f"desc_{desc_id}.txt"
        file_path = os.path.join(DOWNLOAD_DIR, file_name)
        try:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(text)
            with open(file_path, "rb") as f:
                bot.send_document(chat_id, f, visible_file_name="Описание.txt", reply_to_message_id=reply_to_id)
            os.remove(file_path)
        except Exception as e:
            print(f"[Desc File Error] {e}")
            bot.send_message(chat_id, f"{E_CROSS} Ошибка при отправке файла", parse_mode="HTML")
    else:
        try:
            bot.send_message(chat_id, f"📝 <b>Описание:</b>\n\n{text}", parse_mode="HTML", reply_to_message_id=reply_to_id)
        except Exception as e:
            print(f"[Desc Text Error] {e}")
            bot.send_message(chat_id, f"{E_CROSS} Ошибка при отправке текста", parse_mode="HTML")


def process_link_download(message, raw_url, auto_shazam=False):
    url = unwrap_redirect_url(raw_url)
    is_private = message.chat.type == 'private'
    if is_private and not check_user_subscription(message.from_user.id):
        send_subscription_required(message.chat.id, reply_to_message_id=message.message_id)
        return

    chat_id = message.chat.id
    requester_id = message.from_user.id if message.from_user else 0
    platform = detect_platform(url)

    if ("soundcloud.com" in url.lower() or "snd.sc" in url.lower()) and not auto_shazam:
        status_msg = safe_reply(message, f'{E_DL} <i>Скачиваю с SoundCloud...</i>', parse_mode="HTML")
        if not status_msg:
            return

        def sc_download():
            song_path = None
            try:
                dl_res = download_song_ytdlp(url)
                if not dl_res or not os.path.exists(dl_res['path']):
                    safe_edit(f"{E_CROSS} Не удалось скачать трек с SoundCloud", chat_id, status_msg.message_id, parse_mode="HTML")
                    return

                song_path = dl_res['path']
                safe_edit(f'{E_SEND} <i>Отправляю...</i>', chat_id, status_msg.message_id, parse_mode="HTML")
                send_downloaded_song(chat_id, message.message_id, dl_res)
                try:
                    bot.delete_message(chat_id, status_msg.message_id)
                except Exception:
                    pass
            except Exception:
                traceback.print_exc()
                safe_edit(f"{E_CROSS} Ошибка при отправке трека", chat_id, status_msg.message_id, parse_mode="HTML")
            finally:
                if song_path and os.path.exists(song_path):
                    try:
                        os.remove(song_path)
                    except Exception:
                        pass

        threading.Thread(target=sc_download, daemon=True).start()
        return

    status_msg = safe_reply(message, f'{E_DL} <i>Скачиваю с {platform}...</i>', parse_mode="HTML")
    if not status_msg:
        return

    unique_id = f"{chat_id}_{message.message_id}"
    out_tmpl  = os.path.join(DOWNLOAD_DIR, f"{unique_id}.%(ext)s")
    file_path = None

    def process_url():
        nonlocal file_path
        try:
            if "tiktok.com" in url.lower():
                tt_res = download_tiktok_media(url, unique_id)
                if tt_res:
                    if tt_res["type"] == "photos":
                        paths = tt_res["paths"]
                        safe_edit(f'{E_SEND} <i>Отправляю...</i>', chat_id, status_msg.message_id, parse_mode="HTML")
                        clean_cap = clean_title(tt_res.get("title", ""))

                        sent_msg = None
                        if len(paths) == 1:
                            with open(paths[0], "rb") as ph:
                                sent_msg = bot.send_photo(chat_id, ph, reply_to_message_id=message.message_id, timeout=60)
                        else:
                            media_group = []
                            files_to_close = []
                            try:
                                for i, p in enumerate(paths[:10]):
                                    f_obj = open(p, "rb")
                                    files_to_close.append(f_obj)
                                    media_group.append(types.InputMediaPhoto(f_obj))
                                sent_msgs = bot.send_media_group(chat_id, media_group, reply_to_message_id=message.message_id, timeout=120)
                                if sent_msgs:
                                    sent_msg = sent_msgs[0]
                            finally:
                                for f_obj in files_to_close:
                                    try:
                                        f_obj.close()
                                    except Exception:
                                        pass

                        if clean_cap and sent_msg:
                            desc_id = hashlib.md5(f"{clean_cap}_{time.time()}".encode()).hexdigest()[:12]
                            desc_copy_cache[desc_id] = {'text': clean_cap}
                            markup = types.InlineKeyboardMarkup()
                            markup.add(types.InlineKeyboardButton("📄 Да, скопировать описание", callback_data=f"desc_copy:{desc_id}"))
                            bot.send_message(chat_id, "📋 <b>Скопировать описание?</b>", parse_mode="HTML", reply_markup=markup, reply_to_message_id=sent_msg.message_id)

                        for p in paths:
                            try:
                                os.remove(p)
                            except Exception:
                                pass
                        try:
                            bot.delete_message(chat_id, status_msg.message_id)
                        except Exception:
                            pass
                        return

                    elif tt_res["type"] == "video":
                        tiktok_path = tt_res["path"]
                        if auto_shazam:
                            safe_edit(f"{E_SEARCH}", chat_id, status_msg.message_id, parse_mode="HTML")
                            recognize_and_show_options(message, status_msg, tiktok_path, delete_source=True, owner_id=requester_id)
                            return

                        safe_edit(f'{E_SEND} <i>Отправляю...</i>', chat_id, status_msg.message_id, parse_mode="HTML")
                        markup = make_shazam_markup(tiktok_path)
                        with open(tiktok_path, "rb") as video:
                            sent_msg = bot.send_video(chat_id, video, reply_markup=markup, reply_to_message_id=message.message_id, timeout=120)

                        clean_cap = clean_title(tt_res.get("title", ""))
                        if clean_cap and sent_msg:
                            desc_id = hashlib.md5(f"{clean_cap}_{time.time()}".encode()).hexdigest()[:12]
                            desc_copy_cache[desc_id] = {'text': clean_cap}
                            desc_markup = types.InlineKeyboardMarkup()
                            desc_markup.add(types.InlineKeyboardButton("📄 Да, скопировать описание", callback_data=f"desc_copy:{desc_id}"))
                            bot.send_message(chat_id, "📋 <b>Скопировать описание?</b>", parse_mode="HTML", reply_markup=desc_markup, reply_to_message_id=sent_msg.message_id)

                        video_cache[unique_id] = tiktok_path
                        try:
                            bot.delete_message(chat_id, status_msg.message_id)
                        except Exception:
                            pass
                        return

            is_gif_or_img_site = any(d in url.lower() for d in ("tenor.com", "giphy.com", "imgur.com", ".gif", ".jpg", ".png", ".webp"))
            media_info = None

            if is_gif_or_img_site:
                media_info = download_universal_web_media(url, unique_id)

            if not media_info:
                try:
                    media_info = download_via_ytdlp(url, out_tmpl)
                except Exception:
                    media_info = download_universal_web_media(url, unique_id)

            if not media_info:
                media_info = download_universal_web_media(url, unique_id)

            if not media_info:
                safe_edit(f"{E_CROSS} Не получилось скачать материал по ссылке", chat_id, status_msg.message_id, parse_mode="HTML")
                return

            file_path = media_info["path"]
            thumb_url = media_info.get("thumbnail", "")

            if file_path and os.path.exists(file_path):
                if auto_shazam:
                    safe_edit(f"{E_SEARCH}", chat_id, status_msg.message_id, parse_mode="HTML")
                    recognize_and_show_options(message, status_msg, file_path, delete_source=True, owner_id=requester_id)
                    return

                ext  = media_info["ext"].lower()
                clean = clean_title(media_info.get("title", ""))
                safe_edit(f'{E_SEND} <i>Отправляю...</i>', chat_id, status_msg.message_id, parse_mode="HTML")

                thumb_bytes = None
                if thumb_url:
                    try:
                        r = http_session.get(thumb_url, timeout=5)
                        if r.status_code == 200 and len(r.content) < 200 * 1024:
                            thumb_bytes = r.content
                    except Exception:
                        pass

                is_gif_host = any(h in url.lower() for h in ("tenor.com", "giphy.com", "gfycat.com"))

                sent_msg = None
                with open(file_path, "rb") as f:
                    if ext in ["jpg", "jpeg", "png", "webp"]:
                        sent_msg = bot.send_photo(chat_id, f, reply_to_message_id=message.message_id, timeout=60)
                    elif ext == "gif" or is_gif_host:
                        sent_msg = bot.send_animation(chat_id, f, reply_to_message_id=message.message_id, timeout=90)
                    elif ext in ["mp3", "m4a", "ogg", "wav", "flac"]:
                        sent_msg = bot.send_audio(
                            chat_id,
                            f,
                            title=clean or None,
                            caption=TRACK_CAPTION_HTML,
                            parse_mode="HTML",
                            thumbnail=thumb_bytes,
                            reply_to_message_id=message.message_id,
                            timeout=120
                        )
                    elif ext in ["mp4", "mkv", "mov", "webm"]:
                        markup = make_shazam_markup(file_path)
                        sent_msg = bot.send_video(chat_id, f, reply_markup=markup, reply_to_message_id=message.message_id, timeout=120)
                    else:
                        sent_msg = bot.send_document(chat_id, f, visible_file_name=f"{clean or 'media'}.{ext}", reply_to_message_id=message.message_id, timeout=120)

                if clean and sent_msg and ext not in ["mp3", "m4a", "ogg", "wav", "flac"]:
                    desc_id = hashlib.md5(f"{clean}_{time.time()}".encode()).hexdigest()[:12]
                    desc_copy_cache[desc_id] = {'text': clean}
                    desc_markup = types.InlineKeyboardMarkup()
                    desc_markup.add(types.InlineKeyboardButton("📄 Да, скопировать описание", callback_data=f"desc_copy:{desc_id}"))
                    bot.send_message(chat_id, "📋 <b>Скопировать описание?</b>", parse_mode="HTML", reply_markup=desc_markup, reply_to_message_id=sent_msg.message_id)

                try:
                    bot.delete_message(chat_id, status_msg.message_id)
                except Exception:
                    pass
            else:
                safe_edit(f"{E_CROSS} Не получилось скачать", chat_id, status_msg.message_id, parse_mode="HTML")

        except Exception:
            traceback.print_exc()
            safe_edit(f"{E_CROSS} Ошибка при скачивании по ссылке", chat_id, status_msg.message_id, parse_mode="HTML")
            if file_path and os.path.exists(file_path):
                try:
                    os.remove(file_path)
                except Exception:
                    pass

    threading.Thread(target=process_url, daemon=True).start()


@bot.message_handler(func=lambda m: m.text is not None)
def handle_all_text(message):
    text = message.text.strip()
    if not text or text.startswith('/start') or text.startswith('/help') or text.startswith('/admin') or re.match(r'^/(?:q|quote)\b', text, re.I):
        return

    chat_id = message.chat.id
    is_private = message.chat.type == 'private'
    if is_private:
        save_user(message.from_user.id)
    save_storage_chat_id(chat_id)

    url_match = re.search(r'https?://\S+', text)
    has_search_prefix = bool(re.match(
        r'^/?(?:найти|найди|поиск|ищи|скачать|скачай|шазам|shazam|песня|трек|музыка|текст|слова)\b',
        text,
        flags=re.IGNORECASE
    ))

    if url_match:
        raw_url = url_match.group(0)
        clean_url = unwrap_redirect_url(raw_url)
        if not is_supported_url(clean_url) and not is_private and not has_search_prefix:
            return
        process_link_download(message, clean_url, auto_shazam=has_search_prefix)
        return

    if has_search_prefix and message.reply_to_message:
        q_after_cmd = clean_search_query(text)
        if not q_after_cmd:
            if is_private and not check_user_subscription(message.from_user.id):
                send_subscription_required(chat_id, reply_to_message_id=message.message_id)
                return
            if extract_telegram_media_file_id(message.reply_to_message):
                handle_telegram_media_shazam(message, message.reply_to_message)
                return
            reply_text = message.reply_to_message.text or message.reply_to_message.caption or ""
            reply_url_match = re.search(r'https?://\S+', reply_text)
            if reply_url_match:
                process_link_download(message, unwrap_redirect_url(reply_url_match.group(0)), auto_shazam=True)
                return

    if has_search_prefix:
        if is_private and not check_user_subscription(message.from_user.id):
            send_subscription_required(chat_id, reply_to_message_id=message.message_id)
            return

        q_text = clean_search_query(text)
        if not q_text and message.reply_to_message and message.reply_to_message.text:
            q_text = message.reply_to_message.text.strip()
        if len(q_text) >= 2:
            show_track_selection(message, q_text, owner_id=message.from_user.id)
        return

    if is_private and not text.startswith('/'):
        if not check_user_subscription(message.from_user.id):
            send_subscription_required(chat_id, reply_to_message_id=message.message_id)
            return

        if len(text) >= 2:
            show_track_selection(message, text, owner_id=message.from_user.id)


if __name__ == '__main__':
    print("Bot running...")
    bot.remove_webhook()
    bot.infinity_polling(timeout=30, long_polling_timeout=20, allowed_updates=["message", "callback_query"])
