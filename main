        callback_data="sub_check"
    )
    markup.add(btn_sub, btn_check)

    text = (
        f'{E_LOCK} <b>Чтобы использовать бота, подпишитесь на <a href="{NEWS_CHANNEL_URL}">НОВОСТИ</a> моих ботов</b>'
    )
